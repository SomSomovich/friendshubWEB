# Logs
logs
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*
CLAUDE.md

node_modules
dist
dist-ssr
*.local

# Environment. The `VITE_*` values are not secrets — they are inlined into the
# bundle — but they are per deployment, so the template is committed and the
# files made from it are not. The harness's own `.env.harness` is listed below.
.env
.env.*
!.env.example

# The WASM crypto module is built from github.com/SomSomovich/friendshub-wasm.
# Its binary is never committed; rebuild it from the source repo instead.
src/wasm/pkg/*.wasm

# Editor directories and files
.vscode/*
!.vscode/extensions.json
.idea
.DS_Store
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?

# Throwaway credentials created by scripts/*-smoke.mjs
scripts/.smoke-account.json

# Browser harness: the harness itself is committed, its artifacts are not.
dev-tests/*.log
dev-tests/.profile/
dev-tests/.tmp/
dev-tests/dist/
dev-tests/e2e-dist/
dev-tests/.env.e2e
# Build-time environment for the browser harness (written by dev-tests/run.mjs).
.env.harness

dev-tests/.env.harness
dev-tests/ui-dist/
