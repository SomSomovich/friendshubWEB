{
  "name": "friendshubweb",
  "private": true,
  "version": "0.2.4",
  "type": "module",
  "scripts": {
    "predev": "node scripts/fetch-wasm.mjs",
    "dev": "vite",
    "prebuild": "node scripts/fetch-wasm.mjs",
    "proto": "pbjs -t static-module -w es6 -o src/ws/proto/friendshub.js friendshub.proto && pbts -o src/ws/proto/friendshub.d.ts src/ws/proto/friendshub.js",
    "build": "tsc -b && vite build",
    "lint": "eslint .",
    "preview": "vite preview",
    "fetch-wasm": "node scripts/fetch-wasm.mjs",
    "pwa:assets": "node scripts/generate-pwa-assets.mjs",
    "smoke:wasm": "tsx scripts/wasm-smoke.mjs",
    "smoke:http": "tsx scripts/http-smoke.mjs",
    "smoke:ws": "tsx scripts/ws-smoke.mjs",
    "smoke:e2e": "node scripts/full-smoke.mjs"
  },
  "dependencies": {
    "clsx": "^2.1.1",
    "date-fns": "^4.4.0",
    "i18next": "^26.4.2",
    "idb": "^8.0.3",
    "lucide-react": "^1.51.0",
    "protobufjs": "^8.8.0",
    "qrcode": "^1.5.4",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "react-i18next": "^17.0.15",
    "react-router-dom": "^7.18.4",
    "tailwind-merge": "^3.7.0",
    "zustand": "^5.0.15"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@tailwindcss/vite": "^4.3.3",
    "@types/node": "^24.13.3",
    "@types/qrcode": "^1.5.6",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.7",
    "@vite-pwa/assets-generator": "^1.0.4",
    "@vitejs/plugin-react": "^6.1.1",
    "eslint": "^10.10.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.6",
    "globals": "^17.12.0",
    "protobufjs-cli": "^2.7.0",
    "tailwindcss": "^4.3.3",
    "tsx": "^4.23.15",
    "typescript": "~6.0.2",
    "typescript-eslint": "^8.69.0",
    "vite": "^8.3.0",
    "vite-plugin-pwa": "^1.3.0"
  }
}
